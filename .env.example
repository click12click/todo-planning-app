# MongoDB 연결 문자열 (Atlas SRV가 막힌 환경에서는 비-SRV 형식 사용)
# 예: mongodb+srv://user:pass@cluster.xxx.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=

# GitHub OAuth App credentials
# https://github.com/settings/developers 에서 OAuth App 생성
#   Homepage URL          : http://localhost:3000
#   Authorization callback: http://localhost:3000/auth/github/callback
# 발급된 값을 아래에 채워넣고 절대 커밋하지 말 것 (.env 는 .gitignore 에 이미 포함)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
